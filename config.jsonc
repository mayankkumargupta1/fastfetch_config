{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo/softshell_icon.png",
    "type": "kitty-direct",
    "width": 26,
    "height": 13,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#e0e2e8"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#9ecafc"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#9ecafc"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#d5bee5"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#bac8db"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#33618d"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
